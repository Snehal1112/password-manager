# Caddyfile.local — standalone, project-local TLS-terminating reverse proxy
# for manual OIDC testing against numericlabs.lxd. Not used by
# docker-compose (see ./Caddyfile for that) and not installed into the
# system Caddy service at /etc/caddy/Caddyfile.
#
# Run from the repo root. Port 443 is privileged, so this needs either sudo
# or a one-time `sudo setcap cap_net_bind_service=+ep $(which caddy)`:
#   caddy run --config Caddyfile.local
#
# RocketVault must be running separately on :8774 (server.tls.enabled: false).
#
# auto_https disable_redirects: without this, Caddy also listens on :80 for
# an HTTP->HTTPS redirect, which the system caddy.service already owns.
{
	auto_https disable_redirects
}

numericlabs.lxd {
	log {
		format console
		level INFO
	}

	tls /home/numericlabs/data/tls/server.crt /home/numericlabs/data/tls/server.key

	# The Vite dev server (web/, `bun run dev`) is served under /app. Vite is
	# configured with base "/app/", so it already emits /app-prefixed asset and
	# HMR URLs — the prefix must NOT be stripped here. Use `handle`, not
	# `handle_path`. reverse_proxy passes the HMR websocket upgrade through on
	# its own.
	handle /app* {
		reverse_proxy 127.0.0.1:5173
	}

	# The JourneyBook dev server (journeybook/, `bun run dev`) is served under /journeybook.
	handle /journeybook* {
		reverse_proxy 127.0.0.1:5174
	}

	# Rocket-mem exposes Prometheus metrics over plain HTTP on :9121. This proxies
	# only that metrics endpoint. Rocket-mem's RESP protocol itself is not proxied
	# here — RocketVault's rocketmemcache client connects to it directly over raw
	# TCP/TLS (see cache.rocket_mem.addr in .rocketvault.yaml), since RESP is not
	# an HTTP protocol and cannot be routed by path like this.
	handle /metrics* {
		# Rocket-mem's metrics route is an exact string match on "/metrics"
		# (crates/server/src/metrics.rs) -- deliberately not trailing-slash
		# tolerant, to keep e.g. /metrics-admin from accidentally matching. Drop
		# a trailing slash here so a browser's /metrics/ still reaches it.
		uri strip_suffix /
		reverse_proxy 127.0.0.1:9121
	}

	# Everything else is the RocketVault API on :8774.
	handle {
		reverse_proxy 127.0.0.1:8774
	}
}
