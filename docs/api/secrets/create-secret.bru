meta {
  name: Create Secret
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/vaults/{{vault_name}}/secrets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "my-secret",
    "value": "s3cr3t-value",
    "tags": ["env:dev", "team:backend"],
    "content_type": "text/plain"
  }
}
