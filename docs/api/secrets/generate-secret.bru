meta {
  name: Generate Secret
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/secrets/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "generated-password",
    "length": 24,
    "use_symbols": true,
    "use_numbers": true,
    "use_uppercase": true,
    "use_lowercase": true
  }
}
