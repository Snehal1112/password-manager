meta {
  name: Export Secrets
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/vaults/{{vault_name}}/secrets/export
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "format": "json",
    "encrypt": false,
    "include_tags": true,
    "tags": []
  }
}
