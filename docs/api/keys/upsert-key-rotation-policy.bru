meta {
  name: Upsert Key Rotation Policy
  type: http
  seq: 15
}

put {
  url: {{base_url}}/api/v1/vaults/{{vault_name}}/keys/{{key_id}}/rotationpolicy
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "rotate_after_days": 90,
    "notify_before_expiry_days": 30,
    "expiry_days": 365,
    "enabled": true
  }
}
