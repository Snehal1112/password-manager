meta {
  name: Verify Key
  type: http
  seq: 11
}

post {
  url: {{base_url}}/api/v1/vaults/{{vault_name}}/keys/{{key_id}}/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "value": "<base64-encoded-original-data>",
    "signature": "<base64-encoded-signature>",
    "algorithm": "RS256"
  }
}
