meta {
  name: Unwrap Key
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/v1/vaults/{{vault_name}}/keys/{{key_id}}/unwrap
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "wrapped_key": "<base64-encoded-wrapped-bytes>",
    "algorithm": "RSA-OAEP"
  }
}
