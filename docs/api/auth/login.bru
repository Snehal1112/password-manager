meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/users/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}",
    "totp_code": "{{totp_code}}"
  }
}

script:post-response {
  const res = bru.response.getBody();
  if (res && res.token) {
    bru.setEnvVar("token", res.token);
    console.log("Token captured successfully");
  }
}
