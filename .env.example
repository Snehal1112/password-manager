# Copy this file to .env and fill in every value before running:
#
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up --build
#
# Generate random secrets with:
#   openssl rand -base64 32
#
# NEVER commit .env to version control — it is already in .gitignore.

# --- PostgreSQL credentials -----------------------------------------------
POSTGRES_USER=rocketvault
POSTGRES_PASSWORD=           # required — use a strong random password
POSTGRES_DB=rocketvault

# Host port mappings (container-internal ports stay 5432 / 8774).
POSTGRES_PORT=5432
ROCKETVAULT_PORT=8774

# --- RocketVault secrets --------------------------------------------------
# All three are required. The entrypoint will refuse to start if any is unset.
# Re-generate them for every new environment (dev/staging/prod must differ).

# AES-256-GCM master key — used to encrypt secrets at rest.
# Losing this key makes all stored secrets permanently unrecoverable.
# Back it up to a separate secure location (e.g. a password manager or HSM).
RV_MASTER_KEY=               # openssl rand -base64 32

# HMAC secret used to sign and verify JWT tokens.
RV_JWT_SECRET=               # openssl rand -base64 32

# One-time token used by `rocketvault users admin` to bootstrap the first
# admin account. Rotate (set to a new random value) after initial setup.
RV_BOOTSTRAP_TOKEN=          # openssl rand -base64 32

# --- Application settings -------------------------------------------------
# Public URL of this deployment — used for OAuth2 issuer and CORS.
RV_ISSUER=https://vault.yourdomain.com
RV_CORS_ORIGINS=https://vault.yourdomain.com
